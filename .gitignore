# ---- Ambiente virtual e segredos ----
.venv/
venv/
env/
.env

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Dados e modelos (gerados/grandes — não versionar) ----
# Mantemos as pastas via .gitkeep, mas ignoramos o conteúdo.
data/raw/*
data/processed/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# ---- NLTK / caches diversos ----
nltk_data/

# ---- Editores / IDEs ----
.vscode/
.idea/
*.swp

# ---- Sistema operacional ----
.DS_Store
Thumbs.db

# ---- LaTeX (relatório) ----
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
