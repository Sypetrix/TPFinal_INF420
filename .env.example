# ============================================================
#  Modelo de configuração — copie para .env e preencha.
#      cp .env.example .env
#  O arquivo .env (com a chave real) NÃO deve ir para o Git.
# ============================================================

# --- Google Gemini (Google AI Studio) ---
# Crie sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo Gemini Flash a ser usado.
# Opções comuns: gemini-2.5-flash | gemini-2.0-flash | gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Base de dados ---
# Pasta com os dados originais do professor (enunciados + feedbacks_*.json).
ARQUIVOS_DIR=arquivos

# Usar a versão do enunciado com casos de exemplo (txt_with_example)? true/false
USE_EXAMPLES=true

# Como agregar as notas 1-5 dos alunos no rótulo (5 níveis):
#   media -> média aritmética arredondada ao inteiro mais próximo (padrão)
#   moda  -> nota mais frequente
LABEL_STRATEGY=media

# Base consolidada gerada pela Etapa 1 (src.ingest), dentro de data/raw/.
RAW_DATA_FILE=questoes.csv

# Nomes das colunas na base consolidada.
TEXT_COL=enunciado
LABEL_COL=dificuldade
ID_COL=id

# --- Experimentos ---
RANDOM_SEED=42
TEST_SIZE=0.2
