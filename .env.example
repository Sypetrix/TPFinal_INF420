# ============================================================
#  Modelo de configuração — copie para .env e preencha.
#      cp .env.example .env
#  O arquivo .env (com a chave real) NÃO deve ir para o Git.
# ============================================================

# --- Groq Cloud (modelos Llama) ---
# Crie sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui

# Modelo da Groq a ser usado.
# A camada gratuita limita por DIA (RPD) e por minuto (RPM/TPM). O modelo padrão
# abaixo (llama-3.1-8b-instant) tem a MAIOR cota diária gratuita (~14.400 req/dia)
# e é muito rápido — ideal para classificar/extrair conceitos de enunciados.
# Outras opções (qualidade maior, porém cota diária menor):
#   llama-3.3-70b-versatile | llama-3.1-8b-instant
# Limites oficiais: https://console.groq.com/docs/rate-limits
GROQ_MODEL=llama-3.1-8b-instant

# --- Base de dados ---
# Pasta-container com todas as fontes de dados (uma subpasta por fonte).
ARQUIVOS_DIR=arquivos

# Fonte de dados ativa (subpasta de arquivos/ usada pelo pipeline).
# Ex.: INF110 (enunciados + feedbacks de alunos) ou Neps (JSON com a dificuldade
# já dada pelo juiz). Os dados ficam em arquivos/<DATASET>/ e as saídas em
# data/raw/<DATASET>/, data/processed/<DATASET>/ e models/<DATASET>/.
DATASET=INF110

# Formato da fonte (como a Etapa 1 lê os dados brutos):
#   auto       -> detecta sozinho (padrão)
#   feedbacks  -> txt/ + feedbacks_*.json (ex.: INF110)
#   judge_json -> um JSON com a dificuldade do juiz (ex.: Neps)
DATASET_FORMAT=auto

# Fontes que o recomendador combina num só catálogo (separadas por vírgula).
# Como ele é baseado em conteúdo, fontes SEM rótulo (SPOJ, OBI) também servem.
# Vazio -> usa só a fonte ativa (DATASET). Cada fonte precisa ter sido
# consolidada antes (DATASET=<fonte> python -m src.ingest).
RECOMMENDER_SOURCES=INF110,Neps,SPOJ,OBI

# Usar a versão do enunciado com casos de exemplo (txt_with_example)? true/false
USE_EXAMPLES=true

# Como agregar as notas 1-5 dos alunos no rótulo (5 níveis) — só p/ fontes
# 'feedbacks'; em 'judge_json' o rótulo vem direto do juiz:
#   media -> média aritmética arredondada ao inteiro mais próximo (padrão)
#   moda  -> nota mais frequente
LABEL_STRATEGY=media

# Base consolidada gerada pela Etapa 1 (src.ingest), dentro de data/raw/.
RAW_DATA_FILE=questoes.csv

# Nomes das colunas na base consolidada.
TEXT_COL=enunciado
LABEL_COL=dificuldade
ID_COL=id

# --- Vetorização TF-IDF (compartilhada por preprocess, train_ml e evaluate) ---
TFIDF_MAX_FEATURES=5000
TFIDF_NGRAM_MAX=2
TFIDF_MIN_DF=2

# --- Experimentos ---
RANDOM_SEED=42
TEST_SIZE=0.2

# Nº de folds da validação cruzada na avaliação dos modelos (Etapa 3).
# Reduzido automaticamente se a menor classe tiver menos exemplos que isso.
CV_FOLDS=5
