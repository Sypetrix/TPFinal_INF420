# ============================================================
#  Modelo de configuração — copie para .env e preencha.
#      cp .env.example .env
#  O arquivo .env (com a chave real) NÃO deve ir para o Git.
# ============================================================

# --- Google Gemini (Google AI Studio) ---
# Crie sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo Gemini Flash a ser usado.
# Opções comuns: gemini-2.5-flash | gemini-2.0-flash | gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Base de dados ---
# Nome do arquivo dentro de data/raw/ (deixe vazio p/ detectar o 1º .csv).
RAW_DATA_FILE=

# Nomes das colunas no SEU dataset (ajuste conforme a base do professor).
TEXT_COL=enunciado
LABEL_COL=dificuldade
ID_COL=id

# --- Experimentos ---
RANDOM_SEED=42
TEST_SIZE=0.2
